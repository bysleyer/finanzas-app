{
  "name": "finanzas-app",
  "version": "0.1.0",
  "private": true,
  "description": "App de finanzas personales: cuánto puedo gastar hoy sin comprometer mañana.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
